DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=smart_campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
VITE_API_URL=http://localhost:8000/api

# Production security and API protection
DJANGO_SECURE_SSL_REDIRECT=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
API_ANON_RATE=120/minute
API_USER_RATE=1200/hour
LOGIN_RATE=10/minute
TOKEN_REFRESH_RATE=30/minute

# Configure an external object-storage service before production uploads.
# Local MEDIA_ROOT is ephemeral on many cloud hosts.

# Password reset email (set a real frontend reset page and SMTP provider)
PASSWORD_RESET_URL=http://localhost:5173/password-reset
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=CampusMind AI <no-reply@example.com>
PASSWORD_RESET_RATE=5/hour
PASSWORD_RESET_CONFIRM_RATE=10/hour
COLLEGE_REGISTRATION_RATE=3/hour

# Optional OpenAI-compatible AI provider. Keep this key server-side only.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_CHAT_RATE=20/minute

# Optional S3-compatible persistent media storage (AWS S3 / compatible provider)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_QUERYSTRING_AUTH=true
